#!/bin/sh
# INFO dependency checks package presence; this exact-version gate prevents a
# 550/580/595 FFmpeg payload from being paired with another driver release.
set -eu
EXPECTED=__DRIVER__
FOUND=""
DETECTED=""

report_failure() {
    MESSAGE=$1
    printf '%s\n' "$MESSAGE" >&2
    # Synology's package lifecycle scripts can surface this text in the
    # Package Center result dialog through SYNOPKG_TEMP_LOGFILE.
    if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$MESSAGE" > "$SYNOPKG_TEMP_LOGFILE" 2>/dev/null || true
    fi
}
# Include both the legacy package IDs and the current flavor-specific IDs.
# New 580/595 SPKs have distinct IDs, so checking only the old generic IDs
# rejects a valid matching driver before the payload can be installed.
for PACKAGE in \
    syno-nvidia-driver-kver5-580-open \
    syno-nvidia-driver-kver5-580-proprietary \
    syno-nvidia-driver-kver5-595-open \
    syno-nvidia-driver-kver5-595-proprietary \
    syno-nvidia-driver-kver5 \
    syno-nvidia-driver-kver4-dsm72 \
    syno-nvidia-driver-kver4-dsm70; do
    INFO="/var/packages/$PACKAGE/INFO"
    [ -r "$INFO" ] || continue
    PACKAGE_VERSION="$(sed -n 's/^version="\([^"]*\)"$/\1/p' "$INFO" | head -1)"
    [ -n "$PACKAGE_VERSION" ] || continue
    DRIVER_VERSION="$(printf '%s\n' "$PACKAGE_VERSION" | sed 's/-[0-9][0-9]*$//')"
    if [ "$DRIVER_VERSION" = "$EXPECTED" ]; then
        FOUND="$PACKAGE ($PACKAGE_VERSION)"
    else
        DETECTED="${DETECTED}${DETECTED:+; }$PACKAGE ($PACKAGE_VERSION; driver $DRIVER_VERSION)"
    fi
done
[ -n "$FOUND" ] || {
    if [ -n "$DETECTED" ]; then
        if [ "${SYNOPKG_DSM_LANGUAGE:-enu}" = "krn" ]; then
            report_failure "NVIDIA FFmpeg 설치 중단: 요구 드라이버 $EXPECTED, 감지된 드라이버 $DETECTED. 일치하는 NVIDIA 드라이버를 설치하거나 현재 드라이버 버전에 맞는 FFmpeg 패키지를 선택하십시오."
        else
            report_failure "NVIDIA FFmpeg install blocked: requires NVIDIA driver $EXPECTED; detected $DETECTED. Install the matching driver or choose the FFmpeg package for your installed driver."
        fi
    else
        if [ "${SYNOPKG_DSM_LANGUAGE:-enu}" = "krn" ]; then
            report_failure "NVIDIA FFmpeg 설치 중단: 요구 드라이버 $EXPECTED와 일치하는 NVIDIA 드라이버 패키지가 없습니다. 먼저 일치하는 드라이버를 설치하십시오."
        else
            report_failure "NVIDIA FFmpeg install blocked: no matching NVIDIA driver package ($EXPECTED) was detected. Install the matching driver first."
        fi
    fi
    exit 1
}
