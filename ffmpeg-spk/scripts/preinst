#!/bin/sh
# INFO dependency checks package presence; this exact-version gate prevents a
# 550/580/595 FFmpeg payload from being paired with another driver release.
set -eu
EXPECTED=__DRIVER__
FOUND=""
DETECTED=""
# Include both the legacy package IDs and the current flavor-specific IDs.
# New 580/595 SPKs have distinct IDs, so checking only the old generic IDs
# rejects a valid matching driver before the payload can be installed.
for PACKAGE in \
    syno-nvidia-driver-kver5-580-open \
    syno-nvidia-driver-kver5-580-proprietary \
    syno-nvidia-driver-kver5-595-open \
    syno-nvidia-driver-kver5-595-proprietary \
    syno-nvidia-driver-kver5 \
    syno-nvidia-driver-kver4-dsm72 \
    syno-nvidia-driver-kver4-dsm70; do
    INFO="/var/packages/$PACKAGE/INFO"
    [ -r "$INFO" ] || continue
    PACKAGE_VERSION="$(sed -n 's/^version="\([^"]*\)"$/\1/p' "$INFO" | head -1)"
    [ -n "$PACKAGE_VERSION" ] || continue
    DRIVER_VERSION="$(printf '%s\n' "$PACKAGE_VERSION" | sed 's/-[0-9][0-9]*$//')"
    if [ "$DRIVER_VERSION" = "$EXPECTED" ]; then
        FOUND="$PACKAGE ($PACKAGE_VERSION)"
    else
        DETECTED="${DETECTED}${DETECTED:+; }$PACKAGE ($PACKAGE_VERSION; driver $DRIVER_VERSION)"
    fi
done
[ -n "$FOUND" ] || {
    echo "NVIDIA FFmpeg installation blocked: this package requires NVIDIA driver $EXPECTED." >&2
    if [ -n "$DETECTED" ]; then
        echo "Detected installed NVIDIA driver package(s): $DETECTED." >&2
    else
        echo "No supported NVIDIA driver package was detected." >&2
    fi
    echo "Install the matching $EXPECTED driver package first, or choose an FFmpeg package built for the installed driver." >&2
    exit 1
}
