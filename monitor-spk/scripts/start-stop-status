#!/bin/sh
#!/bin/sh
BASE="/var/packages/syno-nvidia-gpu-monitor"
PID="$BASE/var/monitor.pid"
DAEMON="$BASE/target/bin/syno-nvidia-gpu-monitor-daemon.sh"
case "${1:-}" in
 start) [ -r "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && exit 0; nohup "$DAEMON" >/dev/null 2>&1 & exit 0 ;;
 stop) [ -r "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true; rm -f "$PID"; exit 0 ;;
 status) [ -r "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; exit $? ;;
 *) exit 1 ;;
esac
