#!/bin/sh
# Runs unprivileged (see postinst) - hands off to the setuid helper for
# the actual cleanup (unload modules, remove /dev nodes, restore Jellyfin
# service-setup, deregister the Container Manager runtime entry).
set -u
SCRIPTDIR="$(cd "$(dirname "$0")" && pwd)"
RUNTIME="${SCRIPTDIR%/scripts}/target"
HELPER="$RUNTIME/bin/helper/nvidia-helper.x86_64"

[ -u "$HELPER" ] && "$HELPER" uninstall

exit 0
