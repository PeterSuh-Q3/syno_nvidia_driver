#!/bin/sh
# DSM calls this at every boot regardless of the INFO startable/ctl_stop
# flags (confirmed by syno-amdgpu-driver's working package) - those flags
# only hide the Start/Stop buttons in Package Center. "start" is therefore
# the real boot hook. Runs unprivileged (see postinst) - all it does here
# is hand off to the setuid helper, which execs bin/nvidia-backend.sh as
# root.
SCRIPTDIR="$(cd "$(dirname "$0")" && pwd)"
RUNTIME="${SCRIPTDIR%/scripts}/target"
HELPER="$RUNTIME/bin/helper/nvidia-helper.x86_64"

case "${1:-}" in
  start)
    if [ -u "$HELPER" ]; then
      "$HELPER" start
    else
      echo "nvidia-driver: setuid helper not set up ($HELPER)" >&2
      exit 1
    fi
    ;;
  status)
    [ -u "$HELPER" ] && exit 0 || exit 1
    ;;
  stop) exit 0 ;;
  log)  exit 1 ;;
  *)    exit 1 ;;
esac
exit 0
